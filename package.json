{
  "name": "chemview-hmi",
  "version": "1.0.0",
  "description": "Industrial IoT Gateway Simulator with Next.js, Modbus TCP Polling, and Safety Interlocks.",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "genkit:dev": "genkit start -- npx tsx src/ai/dev.ts",
    "test:firestore": "firebase emulators:exec --only firestore --project chemview-test \"vitest run src/server/store.contract.test.ts\""
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.42.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "firebase-admin": "^14.5.0",
    "genkit": "^1.42.0",
    "lucide-react": "^0.475.0",
    "next": "15.5.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "firebase-tools": "^15.32.1",
    "genkit-cli": "^1.43.0",
    "postcss": "^8",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
