# Google AI Studio key used by the Genkit alert flow (rotate it if a real key was ever committed)
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY

# Firebase Admin credentials for server-side persistence (Phase 4)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: when set, POST /api/command needs "Authorization: Bearer <token>" (E-STOP never does).
# This protects tool/server-to-server access only. Do NOT expose it to the browser:
# the dashboard sends no token, so with this set its non-E-STOP buttons are rejected.
# Protect the browser UI with your platform's access control instead.
OPERATOR_TOKEN=
